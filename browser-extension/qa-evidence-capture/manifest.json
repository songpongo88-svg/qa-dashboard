{
  "manifest_version": 3,
  "name": "QA Evidence Capture",
  "version": "1.1.1",
  "description": "Continuously capture evidence across browser tabs and send it back to the active QA Dashboard case.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Start continuous evidence capture"
  },
  "commands": {
    "capture-evidence": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start continuous evidence capture"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
